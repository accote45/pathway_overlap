// ============================================================================
//  NEW USERS: edit the paths in this file to point to your own data/references.
//  Every absolute path below is a placeholder from the original study system
//  and MUST be updated for your environment. See docs/REPRODUCIBILITY.md and
//  data/README.md for what each file is and where to obtain it.
// ============================================================================

// Define parameters as flat key-value pairs
params.traits_config = "${projectDir}/json_files/test.json"   // trait/GWAS table (see json_files/GWAS_input.json)
params.outdir = "${projectDir}/results"
params.num_random_sets = 1000   // number of null gene sets per method (study used 1000; use a small value to smoke-test)
params.randomization_methods = ['birewire','keeppathsize']
params.bfile = "/sc/arion/projects/psychgen/cotea02_prset/subtyping/magma_test/g1000_eur"                       // MAGMA LD reference (1000G EUR) plink prefix
params.geneset_real = "/sc/arion/projects/psychgen/cotea02_prset/pathway_overlap/data/c2.all.v2023.2.Hs.symbols.gmt_filtered.txt"
params.ukb_dir = "/sc/arion/projects/psychgen/cotea02_prset/geneoverlap_nf/data/ukb/"                                   // PRSet UKB validation cohort directory
params.gtf_reference = "/sc/arion/projects/psychgen/cotea02_prset/reference/Homo_sapiens.GRCh37.75.gtf.gz"

// PRSet tool paths (used by modules/prset/prset.nf)
// params.prsice_bin = "/path/to/PRSice_linux"                        // PRSice/PRSet executable
// params.prset_background = "/path/to/msigdb.genes.txt:gene"         // PRSet --background gene coordinate file (with :gene suffix)

//workflow control parameters
params.run_magma = true
params.run_prset = true
params.run_pascalx = true
params.run_empirical = true
params.run_opentargets_correlation = true
params.run_tissue_correlation = true
params.run_malacards_correlation = true
params.run_gsamixer = true
params.run_fpr_analysis = true
params.run_dorothea_correlation = true

// GSA-MiXeR container command (uses singularity, consistent with gsamixer.sh)
params.mixer_sif = "/sc/arion/projects/psychgen/cotea02_prset/geneoverlap_nf/data/gsa_mixer/gsa-mixer.sif"
params.mixer_py  = "singularity exec --home pwd:/home ${params.mixer_sif} python /tools/mixer/precimed/mixer.py"

// PascalX container and reference data
params.pascalx_sif = "/sc/arion/projects/psychgen/cotea02_prset/geneoverlap_nf/pascalx_singularity.sif"
// Host directory holding the EUR.1KG.GRCh37.* reference panel; bind-mounted to /pascalx_ref below
params.pascalx_ref_dir      = "/sc/arion/projects/psychgen/cotea02_prset/geneoverlap_nf/data/pascalx_reference"
// Host directory holding msigdbgenes.regions; bind-mounted to /pascalx_annot below
params.pascalx_annot_dir    = "/sc/arion/projects/psychgen/cotea02_prset/geneoverlap_nf/data"
// Container-internal paths point to mounted host directories (see singularity{} block below)
params.pascalx_ref_panel    = "/pascalx_ref/EUR.1KG.GRCh37"   // writable mount (see singularity{} block below)
params.pascalx_genome_annot = "/pascalx_annot/msigdbgenes.regions"

// References (@ is the GSA-MiXeR per-chromosome wildcard)
params.mixer_ref_bim     = "/sc/arion/projects/psychgen/cotea02_prset/geneoverlap_nf/data/gsa_mixer/1000G_EUR_Phase3_plink/1000G.EUR.QC.@.bim"
params.mixer_ref_loadlib = "/sc/arion/projects/psychgen/cotea02_prset/geneoverlap_nf/data/gsa_mixer/1000G_EUR_Phase3_plink/1000G.EUR.QC.@.bin"
params.mixer_ref_annot   = "/sc/arion/projects/psychgen/cotea02_prset/geneoverlap_nf/data/gsa_mixer/1000G_EUR_Phase3_plink/baseline_v2.2_1000G.EUR.QC.@.annot.gz"

// Any extra mixer flags, or empty
params.mixer_extra_flags = "--seed 1000 --hardprune-r2 0.6 --threads 8"

// Resources
process {
  withName: prepare_gsamixer_sumstats {
    executor = 'lsf'; queue = 'premium'; cpus = 1; memory = '15G'; time = '20m'
    clusterOptions = '-P acc_paul_oreilly'
  }
  withName: split_gsamixer_sumstats {
    executor = 'lsf'; queue = 'premium'; cpus = 1; memory = '4G'; time = '20m'
    clusterOptions = '-P acc_paul_oreilly'
  }
  withName: gsamixer_plsa_base {
    executor = 'lsf'; queue = 'premium'; cpus = 8; memory = '30G'; time = '10h'
    clusterOptions = '-P acc_paul_oreilly'
  }
  withName: gsamixer_plsa_full {
    executor = 'lsf'; queue = 'premium'; cpus = 8; memory = '40G'; time = '24h'
    clusterOptions = '-P acc_paul_oreilly'
  }
  withName: convert_random_gmt_for_gsamixer {
    executor = 'lsf'; queue = 'premium'; cpus = 1; memory = '4G'; time = '1h'
    clusterOptions = '-P acc_paul_oreilly'
  }
  withName: gsamixer_plsa_full_random {
    executor = 'lsf'; queue = 'premium'; cpus = 8; memory = '40G'; time = '24h'
    clusterOptions = '-P acc_paul_oreilly'
  }
  withName: convert_gmt_for_gsamixer {
    executor = 'lsf'
    queue = 'premium'
    cpus = 1
    memory = '4G'
    time = '20m'
    clusterOptions = '-P acc_paul_oreilly'
  }
  
  withName: generate_birewire_random_gmts {
    executor = 'lsf'
    queue = 'premium'
    cpus = 1
    memory = '15G'
    time = '12h'
    clusterOptions = '-P acc_paul_oreilly'
  }
  withName: generate_keeppathsize_random_gmts {
    executor = 'lsf'
    queue = 'premium'
    cpus = 1
    memory = '8G'
    time = '8h'
    clusterOptions = '-P acc_paul_oreilly'
  }
  withName: run_random_sets {
    executor = 'lsf'
    queue='premium'
    clusterOptions='-P acc_paul_oreilly'
    cpus = '1'
    memory = '4G'
    time = '1h'
  }
  withName: run_gene_analysis {
    executor = 'lsf'
    queue='premium'
    clusterOptions = '-P acc_paul_oreilly'
    cpus = '1'
    memory = '50000 MB'
    time = '12h'
  }
  withName: gwas_remove_dup_snps {
    executor = 'lsf'
    queue='premium'
    cpus = '1'
    memory = '16G'
    time = '20m'
    clusterOptions = '-P acc_paul_oreilly'
  }
  withName: run_random_sets_prset {
    executor = 'lsf'
    queue = 'premium'
    time = '4h'
    memory = '80G'
    clusterOptions = '-P acc_paul_oreilly -R "span[ptile=1]"'
  }
  withName: calc_empirical_pvalues {
    executor = 'lsf'
    queue = 'premium'
    clusterOptions = '-P acc_paul_oreilly'
    cpus = '1'
    memory = '50G'
    time = '2h'
  }
  withName: 'opentargets_stats_correlation' {
    executor = 'lsf'
    queue = 'premium'
    clusterOptions = '-P acc_paul_oreilly'
    cpus = '1'
    memory = '12G'
    time = '0.5h'
  }
  withName: 'tissue_correlation_analysis' {
    executor = 'lsf'
    queue = 'premium'
    clusterOptions = '-P acc_paul_oreilly'
    cpus = '2'
    memory = '10G'
    time = '1h'
  }
  withName: 'malacards_correlation' {
    executor = 'lsf'
    queue = 'premium'
    clusterOptions = '-P acc_paul_oreilly'
    cpus = '1'
    memory = '8G'
    time = '30m'
  }
  withName: run_real_prset {
    executor = 'lsf'
    queue = 'premium'
    time = '4h'
    cpus = 1
    memory = '80G'
    clusterOptions = '-P acc_paul_oreilly -R "span[ptile=1]"'
  }
  withName: calculate_fpr {
    executor = 'lsf'
    queue = 'premium'
    clusterOptions = '-P acc_paul_oreilly'
    cpus = '1'
    memory = '8G'
    time = '1h'
  }
    withName: 'dorothea_correlation' {
    executor = 'lsf'
    queue = 'premium'
    clusterOptions = '-P acc_paul_oreilly'
    cpus = '1'
    memory = '8G'
    time = '30m'
  }
  withName: run_pascalx_genes {
    executor = 'lsf'
    queue = 'premium'
    // Nextflow's LSF executor auto-adds span[hosts=1] for multi-cpu jobs,
    // keeping PascalX's worker processes (parallel=task.cpus) on the cores we
    // reserved. Do NOT add it here too: LSF rejects duplicate
    // -R "span[...]" strings.
    clusterOptions = '-P acc_paul_oreilly'
    cpus = 8
    memory = '64G'
    time = '4h'
    beforeScript = 'module load apptainer/1.3.6'
  }
  withName: run_real_pascalx {
    executor = 'lsf'
    queue = 'premium'
    clusterOptions = '-P acc_paul_oreilly'
    cpus = '1'
    memory = '50G'
    time = '4h'
    beforeScript = 'module load apptainer/1.3.6'
  }
  withName: run_random_sets_pascalx {
    executor = 'lsf'
    queue = 'premium'
    clusterOptions = '-P acc_paul_oreilly'
    cpus = '1'
    memory = '50G'
    time = '4h'
    beforeScript = 'module load apptainer/1.3.6'
  }
}

// Directory containing OpenTargets associationByDatatypeDirect JSON files
params.opentargets_json_dir = "/sc/arion/projects/psychgen/cotea02_prset/geneoverlap/results/drugtarget_test/associationByDatatypeDirect"

params {
  gene_file = "/sc/arion/projects/psychgen/cotea02_prset/geneoverlap/data/msigdbgenes.regions"   // MAGMA gene-location file

  // GMT directories for different randomization methods
  gmt_dirs = [
    birewire: "${params.outdir}/randomized_gene_sets/random_birewire",
    keeppathsize: "${params.outdir}/randomized_gene_sets/random_keeppathsize"
  ]
  
  // Control whether to generate random GMT files at pipeline start
  generate_random_gmts = true

  // Directory for scripts
  scripts_dir = "${projectDir}/scripts"

  opentargets_supported_traits = [
    "t2d", "cad", "ad", "mdd", "scz", "ibd", "breast"
  ]

  // tissue specificity data (GTEx-derived specificity tables; see data/README.md)
    tissue_expression_data = "/sc/arion/projects/psychgen/cotea02_prset/judit_revisions/software/1kg_test/GeneExpressionLandscape/data/Exp_Spe_DataTables/specificity"

  malacards_path = "/sc/arion/projects/psychgen/cotea02_prset/geneoverlap_nf/data/Malacards"

  // Only run MalaCards for these traits (case-insensitive)
  malacards_traits = 'bmi,cad,t2d,mdd,ad,scz,ibd,breast'

  //dorothea analysis (precomputed pairwise pathway scores; see data/README.md)
  dorothea_scores_path = "/sc/arion/projects/psychgen/cotea02_prset/geneoverlap_nf/data/dorothea_pairwise_scores.csv"
}

executor {
  queueSize = 500
}

singularity {
  enabled = true
  autoMounts = true
  runOptions = "--bind ${projectDir}/scripts:/scripts:ro," +
               "${projectDir}/data:/data:ro," +
               "${params.outdir}/randomized_gene_sets:/randomized_gene_sets:ro," +
               "${params.pascalx_ref_dir}:/pascalx_ref," +   // writable — no :ro
               "${params.pascalx_annot_dir}:/pascalx_annot:ro"
}