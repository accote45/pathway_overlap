// ============================================================================
//  GSR simulation sub-pipeline configuration.
//
//  This is a SELF-CONTAINED pipeline: it never reads or writes the repository
//  root's main.nf / nextflow.config, and it modifies nothing in scripts/core.
//  It only READS the parent repo's scripts/core/*.R by absolute path, so the
//  randomization and empirical-p/SES maths are literally the study's own code.
//
//  Run from this directory:  nextflow run main.nf -resume
// ============================================================================

// ---- inherited assets (instructions Sec. 1) --------------------------------
// These MUST match the parent pipeline's nextflow.config. Verified by the
// prepare_reference step, which fails loudly if a path does not resolve.
params.repo_dir  = "${projectDir}/.."
params.core_scripts = "${params.repo_dir}/scripts/core"       // BiRewire / PS / empirical-p
params.sim_scripts  = "${projectDir}/scripts"

params.bfile     = "/sc/arion/projects/psychgen/cotea02_prset/subtyping/magma_test/g1000_eur"
params.gene_file = "/sc/arion/projects/psychgen/cotea02_prset/geneoverlap/data/msigdbgenes.regions"
// Environment-module commands, as parameters so the pipeline can also run
// somewhere that has magma/R on PATH already (local_test sets both to a no-op).
params.load_magma = "module load magma_gwas/1.10"
params.load_r     = "module load R"

params.outdir = "${projectDir}/results"

// ---- simulation design (instructions Sec. 2-4) -----------------------------
params.n_replicates   = 50        // per condition; 100 for the final run
params.num_random_sets = 1000     // null databases per method, matches the paper
params.batch_size     = 100       // null databases scored per MAGMA call (see 04/05)
params.gwas_n         = 200000    // fixed sample size across all conditions

params.n_pathways          = 100
params.pathway_size        = 50
params.n_enriched_per_tier = 10
params.n_contaminable_nulls = 35
params.hub_degree          = 10
params.hub_slots_in_high   = 1
params.frac_causal         = 1.0
params.variable_sizes      = false

params.max_block_snps = 2000      // cap on one MVN draw
params.ld_lambda      = 0.01      // LD shrinkage toward the identity
params.independent_z  = false     // true = Sec.4 fast fallback, NOT for final results

params.min_snps_per_gene = 10

// ---- effect sizes ----------------------------------------------------------
// Sec. 3 forbids magic numbers: run `-entry calibrate` first, then paste the
// values from results/calibration/calibration_mu.env here.
params.mu_low  = null
params.mu_med  = null
params.mu_high = null
params.mu_hub  = -1               // <0 means "use mu_high", per Sec. 3
params.effect_scale = 1.0         // the small / medium / large axis

// Calibration pilot grid (0% overlap, all tiers share one mu)
// The pilot calibrates on Original (raw MAGMA p), which needs no null
// databases at all, so `-entry calibrate` skips randomization entirely.
// Override the replicate count on the command line if the curve looks noisy:
//   nextflow run main.nf -entry calibrate --n_replicates 10
params.calibration_mu_grid = [0.05, 0.08, 0.12, 0.18, 0.27, 0.40]

// ---- conditions (instructions Sec. 10 step 1 = the MVP) --------------------
params.conditions = [
  [name: 'ov00',         overlap_frac: 0.00, hub_signal: true ],
  [name: 'ov05',         overlap_frac: 0.05, hub_signal: true ],
  [name: 'ov05_nullhub', overlap_frac: 0.05, hub_signal: false]
]
// Sec. 10 step 3 (add when time allows):
//   [name: 'ov10', overlap_frac: 0.10, hub_signal: true],
//   [name: 'ov20', overlap_frac: 0.20, hub_signal: true]
params.overlap_map  = "ov00=0,ov05=5,ov05_nullhub=5"
params.main_cond    = "ov05"
params.nullhub_cond = "ov05_nullhub"

params.randomization_methods = ['birewire', 'keeppathsize']
params.alpha = 0.05
params.top_k = 30

params.run_birewire_diagnostics = true
params.run_batch_verification   = true

// ---- resources -------------------------------------------------------------
// Executor and queue are parameters, not literals, so the `local_test` profile
// can move every process off LSF. A profile-level `process.executor` would NOT
// work here: per-process `withName:` settings take priority over it.
params.executor        = 'lsf'
params.queue           = 'premium'
params.cluster_options = '-P acc_paul_oreilly'

process {
  errorStrategy = { task.attempt <= 2 ? 'retry' : 'finish' }
  maxRetries = 2

  withName: prepare_reference {
    executor=params.executor; queue=params.queue; cpus=1; memory='16G'; time='1h'
    clusterOptions=params.cluster_options
  }
  withName: magma_annotate {
    executor=params.executor; queue=params.queue; cpus=1; memory='8G'; time='1h'
    clusterOptions=params.cluster_options
  }
  withName: build_architecture {
    executor=params.executor; queue=params.queue; cpus=1; memory='4G'; time='20m'
    clusterOptions=params.cluster_options
  }
  withName: simulate_sumstats {
    // one Cholesky per LD block, one block in memory at a time
    executor=params.executor; queue=params.queue; cpus=1; memory='16G'; time='2h'
    clusterOptions=params.cluster_options
  }
  withName: magma_gene_analysis {
    executor=params.executor; queue=params.queue; cpus=1; memory='16G'; time='4h'
    clusterOptions=params.cluster_options
  }
  withName: randomize_gmts {
    // 100 x 50 matrix: orders of magnitude smaller than the real 5878-pathway
    // database, so minutes rather than the parent pipeline's 6-12 h
    executor=params.executor; queue=params.queue; cpus=4; memory='8G'; time='3h'
    clusterOptions=params.cluster_options
  }
  withName: magma_geneset_real {
    executor=params.executor; queue=params.queue; cpus=1; memory='8G'; time='30m'
    clusterOptions=params.cluster_options
  }
  withName: magma_geneset_random_batch {
    executor=params.executor; queue=params.queue; cpus=1; memory='16G'; time='2h'
    clusterOptions=params.cluster_options
  }
  withName: calc_empirical {
    executor=params.executor; queue=params.queue; cpus=4; memory='16G'; time='1h'
    clusterOptions=params.cluster_options
  }
  withName: metrics {
    executor=params.executor; queue=params.queue; cpus=1; memory='4G'; time='20m'
    clusterOptions=params.cluster_options
  }
  withName: 'aggregate_results|figures|fit_calibration|metrics_original' {
    executor=params.executor; queue=params.queue; cpus=1; memory='16G'; time='1h'
    clusterOptions=params.cluster_options
  }
  withName: birewire_diagnostics {
    executor=params.executor; queue=params.queue; cpus=1; memory='8G'; time='4h'
    clusterOptions=params.cluster_options
  }
  withName: verify_batching {
    executor=params.executor; queue=params.queue; cpus=1; memory='8G'; time='30m'
    clusterOptions=params.cluster_options
  }
}

executor {
  queueSize = 500
  perJobMemLimit = true
}

// Provenance: a resolved record of every path and parameter actually used,
// which is what instructions Sec. 1 asks config.yaml to capture.
timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.txt" }

profiles {
  // Off-cluster smoke test: everything local, tiny sweep, no LSF.
  local_test {
    // A profile-level `params.executor` would be too late: the process block
    // above is evaluated at config-parse time, before profile params land. A
    // withName selector defined here is merged after, so it wins.
    process {
      withName: '.*' { executor = 'local'; queue = null; clusterOptions = null
                       memory = null; time = null; cpus = 1 }
    }
    params.load_magma = ":"
    params.load_r     = ":"
    params.n_replicates = 2
    params.num_random_sets = 20
    params.batch_size = 10
  }
}
